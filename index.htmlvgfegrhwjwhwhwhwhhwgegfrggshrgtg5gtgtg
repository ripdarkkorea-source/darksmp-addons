<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DarkSMP — Addons</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --void: #0d0a16;
    --void-2: #16111f;
    --slot: #1e1830;
    --slot-border: #382a4f;
    --amethyst: #9b7fd4;
    --amethyst-glow: #b79cf0;
    --pearl: #5ce1c9;
    --bone: #e9e4f2;
    --bone-dim: #a89fbd;
    --danger: #ff6b5c;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--void);
    color: var(--bone);
    font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background-image:
      radial-gradient(circle at 20% 0%, rgba(155,127,212,0.10), transparent 45%),
      radial-gradient(circle at 90% 30%, rgba(92,225,201,0.06), transparent 40%);
    min-height: 100vh;
  }

  /* ---------- Header ---------- */
  header {
    padding: 44px 20px 28px;
    text-align: center;
    position: relative;
  }

  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--pearl);
    margin: 0 0 10px;
  }

  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: clamp(30px, 8vw, 46px);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
    background: linear-gradient(180deg, #fff, var(--amethyst-glow));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  header p.sub {
    color: var(--bone-dim);
    font-size: 14.5px;
    max-width: 420px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* ---------- Category tabs ---------- */
  .tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 24px auto 0;
    padding: 0 20px;
  }

  .tab {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 13.5px;
    background: var(--void-2);
    border: 1px solid var(--slot-border);
    color: var(--bone-dim);
    padding: 10px 22px;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color .15s ease, color .15s ease, background .15s ease;
  }

  .tab.active {
    color: var(--void);
    background: linear-gradient(180deg, var(--amethyst-glow), var(--amethyst));
    border-color: var(--amethyst);
  }

  .tab:not(.active):hover {
    border-color: var(--amethyst);
    color: var(--bone);
  }

  /* ---------- Search ---------- */
  .search-wrap {
    max-width: 480px;
    margin: 28px auto 0;
    padding: 0 20px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--void-2);
    border: 1px solid var(--slot-border);
    border-radius: 12px;
    padding: 13px 16px;
    transition: border-color .2s, box-shadow .2s;
  }

  .search-box:focus-within {
    border-color: var(--amethyst);
    box-shadow: 0 0 0 3px rgba(155,127,212,0.15);
  }

  .search-box svg { flex-shrink: 0; opacity: 0.6; }

  .search-box input {
    background: none;
    border: none;
    outline: none;
    color: var(--bone);
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    width: 100%;
  }

  .search-box input::placeholder { color: var(--bone-dim); }

  .result-count {
    text-align: center;
    font-size: 12px;
    color: var(--bone-dim);
    margin-top: 10px;
    font-family: 'JetBrains Mono', monospace;
  }

  /* ---------- Grid ---------- */
  .grid {
    max-width: 760px;
    margin: 26px auto 60px;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 14px;
  }

  .card {
    background: var(--slot);
    border: 1px solid var(--slot-border);
    border-radius: 14px;
    padding: 14px 10px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    cursor: pointer;
    position: relative;
    transition: transform .15s ease, border-color .15s ease, box-shadow .15s ease;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 14px;
    padding: 1px;
    background: linear-gradient(135deg, transparent, transparent);
    opacity: 0;
    transition: opacity .2s;
  }

  .card:active { transform: scale(0.96); }

  .card:hover, .card:focus-visible {
    border-color: var(--amethyst);
    box-shadow: 0 0 0 1px var(--amethyst) inset, 0 8px 20px -8px rgba(155,127,212,0.5);
    outline: none;
  }

  .card-icon {
    width: 56px;
    height: 56px;
    border-radius: 10px;
    object-fit: cover;
    margin-bottom: 10px;
    background: var(--void);
    border: 1px solid var(--slot-border);
  }

  .card-name {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 13px;
    line-height: 1.25;
    color: var(--bone);
  }

  .card-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    color: var(--pearl);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
  }

  .empty {
    grid-column: 1/-1;
    text-align: center;
    padding: 50px 20px;
    color: var(--bone-dim);
    font-size: 14px;
  }

  /* ---------- Detail sheet ---------- */
  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(6,4,10,0.7);
    backdrop-filter: blur(3px);
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s ease;
    z-index: 10;
  }
  .overlay.open { opacity: 1; pointer-events: auto; }

  .sheet {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    max-width: 520px;
    margin: 0 auto;
    background: var(--void-2);
    border: 1px solid var(--slot-border);
    border-bottom: none;
    border-radius: 22px 22px 0 0;
    padding: 10px 22px 28px;
    transform: translateY(100%);
    transition: transform .28s cubic-bezier(.32,.72,0,1);
    z-index: 11;
    max-height: 86vh;
    overflow-y: auto;
  }
  .sheet.open { transform: translateY(0); }

  .sheet-handle {
    width: 36px;
    height: 4px;
    background: var(--slot-border);
    border-radius: 4px;
    margin: 10px auto 18px;
  }

  .sheet-top {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .sheet-icon {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    object-fit: cover;
    border: 1px solid var(--slot-border);
    flex-shrink: 0;
  }

  .sheet-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 19px;
    margin: 0 0 4px;
  }

  .sheet-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--pearl);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sheet-desc {
    margin: 20px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--bone-dim);
    white-space: pre-line;
  }

  .sheet-download {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin-top: 22px;
    padding: 15px;
    border-radius: 12px;
    border: none;
    background: linear-gradient(180deg, var(--amethyst-glow), var(--amethyst));
    color: #1a1226;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    box-shadow: 0 10px 24px -10px rgba(155,127,212,0.6);
    transition: filter .15s;
  }
  .sheet-download:active { filter: brightness(0.92); }

  .sheet-size {
    text-align: center;
    font-size: 11.5px;
    color: var(--bone-dim);
    margin-top: 10px;
    font-family: 'JetBrains Mono', monospace;
  }

  .sheet-installs {
    text-align: center;
    font-size: 12px;
    color: var(--pearl);
    margin-top: 6px;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.03em;
  }

  .card-installs {
    font-size: 10px;
    color: var(--pearl);
    font-family: 'JetBrains Mono', monospace;
    margin-top: 3px;
    opacity: 0.85;
  }

  footer {
    text-align: center;
    padding: 20px;
    color: var(--bone-dim);
    font-size: 11.5px;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.04em;
  }
</style>
</head>
<body>

<header>
  <p class="eyebrow">RIP_DARK · Bedrock Edition</p>
  <h1>Addon Vault</h1>
  <p class="sub">Texture packs and addons made by RIP_DARK. Tap one to see the description and download it.</p>
</header>

<div class="tabs">
  <button class="tab active" data-category="addons" onclick="setCategory('addons', this)">Addons</button>
  <button class="tab" data-category="apps" onclick="setCategory('apps', this)">Apps</button>
</div>

<div class="search-wrap">
  <div class="search-box">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input id="search" type="text" placeholder="Search for an addon...">
  </div>
  <p class="result-count" id="resultCount"></p>
</div>

<div class="grid" id="grid"></div>

<footer>RIP_DARK-addons</footer>

<div class="overlay" id="overlay"></div>
<div class="sheet" id="sheet">
  <div class="sheet-handle"></div>
  <div class="sheet-top">
    <img class="sheet-icon" id="sheetIcon" src="" alt="">
    <div>
      <p class="sheet-meta" id="sheetTag"></p>
      <h2 class="sheet-title" id="sheetTitle"></h2>
    </div>
  </div>
  <p class="sheet-desc" id="sheetDesc"></p>
  <a class="sheet-download" id="sheetDownload" href="#" target="_blank" rel="noopener">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3v12"></path>
      <path d="M7 10l5 5 5-5"></path>
      <path d="M5 21h14"></path>
    </svg>
    Download
  </a>
  <p class="sheet-installs" id="sheetInstalls">— installs</p>
  <p class="sheet-size" id="sheetSize"></p>
</div>

<script>
  // ================================================================
  // ADAUGĂ ADDON-URI NOI AICI. Copiază un obiect { ... } și modifică.
  // icon = link către o imagine (poți folosi orice link direct .png/.jpg)
  // download = linkul direct de pe GitHub Releases
  // ================================================================
  const addons = [
    {
      name: "Minecraft",
      tag: "Bedrock Edition",
      category: "apps",
      icon: "data:image/png;base64,",
      description: "Minecraft is a sandbox, open-world game where you can build, craft, explore, and survive. Gather resources, build anything from houses and farms to entire cities, explore procedurally generated worlds, and play solo or with friends. Creative mode gives you unlimited resources, while Survival mode has you gathering materials, crafting tools, and facing the dangers of the night. Minecraft: Bedrock Edition also supports multiplayer, servers, Realms, and lets you customize your experience with addons and resource packs.",
      download: "https://github.com/ripdarkkorea-source/darksmp-addons/releases/download/v2.5/Minecraft-v1.26.44.3-full-apkvision.apk",
      size: "26.44"
    },
    {
      name: "Dynamic First Person Model",
      tag: "Resource Pack",
      category: "addons",
      icon: "data:image/jpeg;base64,",
      description: "Adds a visible first-person body: you can now see your character's arms, legs, and torso while playing, including underwater and while swimming, instead of just floating hands. Makes first-person gameplay feel more immersive and realistic, matching what other players see of you in third person.",
      download: "https://github.com/ripdarkkorea-source/darksmp-addons/releases/download/v1.2/Dynamic.First.Person.Model.v1.5.2.mcaddon",
      size: "N/A"
    },
    {
      name: "Enchant Icon for Bedrock",
      tag: "Texture Pack",
      category: "addons",
      icon: "data:image/jpeg;base64,",
      description: "Adds custom, colorful icons for enchanted books, replacing the default plain book texture with icons that clearly reflect each enchantment. Makes it much easier to recognize enchantments at a glance in your inventory or chests.",
      download: "https://github.com/ripdarkkorea-source/darksmp-addons/releases/download/V3.0/enchant-icon-for-bedrock-1.0.1.mcpack",
      size: "N/A"
    },
    {
      name: "Actions & Stuff",
      tag: "Resource Pack",
      category: "addons",
      icon: "data:image/jpeg;base64,",
      description: "Actions & Stuff is a resource pack created by Oreville Studios for Minecraft Bedrock Edition, officially available on the Marketplace. It doesn't change the gameplay — it completely transforms the visual side of the game.\n\nWhat's new:\n• Completely reworked player animations (1st & 3rd person)\n• New and much more natural mob movements\n• 3D item models (weapons and tools no longer look flat)\n• Custom armor with improved details\n• Fully reworked textures, keeping the classic Minecraft style\n• New particles: water splashes, dust on landing, sweat on mobs while running\n\nCompatible with vanilla textures or other resource packs. Rating: 4.9★ from over 130,000 reviews on the Marketplace.\n\nPrice: 1690 Minecoins on the official Marketplace — but on our site, you get it 100% FREE.",
      download: "https://github.com/ripdarkkorea-source/darksmp-addons/releases/download/v1.0/ActionsAndStuff-1.mcpack",
      size: "28.6 MB"
    },
    {
      name: "Spectral Bedrock Edition",
      tag: "Resource Pack",
      category: "addons",
      icon: "data:image/jpeg;base64,",
      description: "This resource pack aims to keep a familiar tone, but with a bit more warmth. It is not vanilla-like, every texture has been created completely from scratch. Some blocks look decently different from their vanilla counterparts, but still fit in with the overall feel of Minecraft.",
      download: "https://github.com/ripdarkkorea-source/darksmp-addons/releases/download/v2.0/SpectralBE_0.7.0.mcpack",
      size: "—"
    }
  ];

  const grid = document.getElementById('grid');
  const searchInput = document.getElementById('search');
  const resultCount = document.getElementById('resultCount');
  const overlay = document.getElementById('overlay');
  const sheet = document.getElementById('sheet');

  let currentCategory = 'addons';

  const FALLBACK_ICON = "data:image/svg+xml;utf8," + encodeURIComponent(
    `<svg xmlns='http://www.w3.org/2000/svg' width='56' height='56'><rect width='56' height='56' fill='%231e1830'/><rect x='16' y='16' width='24' height='24' fill='%239b7fd4' opacity='0.5'/></svg>`
  );

  function renderGrid(list) {
    grid.innerHTML = '';
    if (list.length === 0) {
      grid.innerHTML = '<p class="empty">Nothing found. Try a different keyword.</p>';
      resultCount.textContent = '';
      return;
    }
    resultCount.textContent = list.length + (list.length === 1 ? ' item' : ' items');
    list.forEach((addon, i) => {
      const card = document.createElement('button');
      card.className = 'card';
      card.setAttribute('aria-label', 'Open ' + addon.name);
      card.innerHTML = `
        <img class="card-icon" src="${addon.icon}" onerror="this.src='${FALLBACK_ICON}'" alt="">
        <span class="card-name">${addon.name}</span>
        <span class="card-tag">${addon.tag}</span>
      `;
      card.addEventListener('click', () => openSheet(addon));
      grid.appendChild(card);
    });
  }

  const COUNTER_NAMESPACE = 'darksmp-ripdark-addons';

  function slugify(name) {
    return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }

  function updateInstallsLabel(value) {
    const el = document.getElementById('sheetInstalls');
    el.textContent = value + (value === 1 ? ' install' : ' installs');
  }

  function openSheet(addon) {
    document.getElementById('sheetIcon').src = addon.icon;
    document.getElementById('sheetIcon').onerror = function(){ this.src = FALLBACK_ICON; };
    document.getElementById('sheetTag').textContent = addon.tag;
    document.getElementById('sheetTitle').textContent = addon.name;
    document.getElementById('sheetDesc').textContent = addon.description;
    document.getElementById('sheetDownload').href = addon.download;
    document.getElementById('sheetSize').textContent = addon.size ? ('File size: ' + addon.size) : '';

    const key = slugify(addon.name);
    document.getElementById('sheetInstalls').textContent = 'Loading installs\u2026';
    document.getElementById('sheetDownload').dataset.key = key;

    fetch('https://abacus.jasoncameron.dev/get/' + COUNTER_NAMESPACE + '/' + key)
      .then(r => r.ok ? r.json() : { value: 0 })
      .then(data => updateInstallsLabel(data.value || 0))
      .catch(() => { document.getElementById('sheetInstalls').textContent = ''; });

    overlay.classList.add('open');
    sheet.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  document.getElementById('sheetDownload').addEventListener('click', function() {
    const key = this.dataset.key;
    if (!key) return;
    fetch('https://abacus.jasoncameron.dev/hit/' + COUNTER_NAMESPACE + '/' + key)
      .then(r => r.ok ? r.json() : null)
      .then(data => { if (data) updateInstallsLabel(data.value); })
      .catch(() => {});
  });

  function closeSheet() {
    overlay.classList.remove('open');
    sheet.classList.remove('open');
    document.body.style.overflow = '';
  }

  overlay.addEventListener('click', closeSheet);

  function applyFilters() {
    const q = searchInput.value.trim().toLowerCase();
    const filtered = addons.filter(a =>
      a.category === currentCategory &&
      (a.name.toLowerCase().includes(q) ||
       a.tag.toLowerCase().includes(q) ||
       a.description.toLowerCase().includes(q))
    );
    renderGrid(filtered);
  }

  function setCategory(category, btn) {
    currentCategory = category;
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    searchInput.value = '';
    applyFilters();
  }

  searchInput.addEventListener('input', applyFilters);

  applyFilters();
</script>

</body>
</html>
